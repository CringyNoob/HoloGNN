# =============================================================================
# Holo-GNN — single repository .gitignore (model + app + paper)
# =============================================================================

# --- Raw data & ETL output (never commit the multi-GB datasets) -------------
data/
CLEANED_DATA/
pandoc_dir/
HoloGNN/data/
HOLOGNN_APP/**/data/

# Large data file extensions (safety net if saved outside data/)
*.sptxt
*.csv
*.tsv
*.zip
*.gz
*.vcf
*.fasta
*.fastq
*.parquet

# --- Trained model weights (heavy; regenerated by training) -----------------
*.pth
*.pt
*.ckpt

# --- App runtime: local SQLite prediction-history DB (regenerated on use) ----
*.db
*.sqlite
*.sqlite3

# --- Evaluation outputs ------------------------------------------------------
metrics_*.json

# --- Python ------------------------------------------------------------------
__pycache__/
*.pyc
*.pyo
.venv/
.venv-test/
venv/
env/
*.egg-info/
.ipynb_checkpoints/

# --- Node / Vite (frontend) --------------------------------------------------
node_modules/
HOLOGNN_APP/frontend/dist/
npm-debug.log*
yarn-error.log*

# --- LaTeX build artifacts (the paper) --------------------------------------
*.aux
*.lof
*.log
*.lot
*.fls
*.out
*.toc
*.fmt
*.fot
*.cb
*.cb2
*.synctex.gz
*.bbl
*.blg
*.run.xml
*.bcf
*.fdb_latexmk

# --- Scratch figures (keep the real figures in HoloGNN/images/) -------------
debug_plot.png

# --- OS / editor junk --------------------------------------------------------
.DS_Store
__MACOSX/
Thumbs.db
.vscode/
.idea/

# --- Local Claude Code settings (machine-local, not for the public repo) -----
.claude/
