# --- 1. CORE DATA PROTECTION (The Data Folders) ---
# Protects the raw files and the massive ETL output shards
data/
CLEANED_DATA/
pandoc_dir/

# --- 2. SPECIFIC LARGE FILE EXTENSIONS (Safety Net) ---
# In case data is accidentally saved in the root directory
*.sptxt
*.csv
*.tsv
*.zip
*.gz
*.vcf
*.fasta
*.fastq
*.xml
*.parquet

# --- 3. MODEL WEIGHTS (The Heavy Brains) ---
# Prevent uploading 100MB+ model files
*.pth
*.pt
*.ckpt

# --- 4. PYTHON GARBAGE ---
# Bytecode and cache
__pycache__/
*.pyc

# --- 5. OS & EDITOR JUNK ---
# Mac/Windows artifacts
.DS_Store
__MACOSX/
Thumbs.db
.vscode/

# --- 6. SPECIFIC DEBUG IMAGES ---
# Ignore the scratchpad plot, but KEEP the final result figures (Figure_*.png)
debug_plot.png